# ── Meta / WhatsApp Cloud API ──────────────────────────────────────────────
# Token de acceso (temporal del panel o token de sistema). Panel: developers.facebook.com → tu app → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=
# ID del número de teléfono (el "Phone number ID" del número de prueba, NO el número en sí)
WHATSAPP_PHONE_NUMBER_ID=
# ID de la cuenta de WhatsApp Business (WABA)
WHATSAPP_WABA_ID=
# Token inventado por vos para verificar el webhook (tiene que coincidir con el que pongas en el panel de Meta)
WHATSAPP_VERIFY_TOKEN=elegi-un-token-secreto
# App secret de la app de Meta (Settings → Basic) — para validar la firma X-Hub-Signature-256
META_APP_SECRET=
GRAPH_API_VERSION=v23.0

# ── OpenAI ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_VOICE=marin

# ── App ────────────────────────────────────────────────────────────────────
# Token interno que usa la web para hablar con este backend (inventá uno largo)
AGENT_API_TOKEN=elegi-otro-token-secreto
# URL pública del backend (la del túnel cloudflared en dev)
PUBLIC_BASE_URL=http://localhost:8000
# Números a los que se permite llamar, separados por coma (E.164). VACÍO = no llama a nadie.
ALLOWED_DESTINATIONS=+5491100000000
# Corte de seguridad de duración de llamada
MAX_CALL_MINUTES=10
HOST=0.0.0.0
PORT=8000
